<Project Sdk="Microsoft.NET.Sdk">

	<!-- App Android de los albañiles: tareas con avance, fotos y videos, fichada, pedidos, problemas y parte diario. -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>DeepArquitectura.Albanil</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Deep Cuadrilla</ApplicationTitle>
		<ApplicationId>com.deeparquitectura.cuadrilla</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 8+ (API 26): cubre prácticamente todos los teléfonos en uso. -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormats>apk;aab</AndroidPackageFormats>
	</PropertyGroup>

	<!-- Servidor de fábrica (mismo criterio que la app del capataz): al publicar
	     -p:ServidorApp=https://<webAppUrl del deploy>. Fuera de Debug no hay valor por defecto. -->
	<PropertyGroup>
		<ServidorApp Condition="'$(ServidorApp)' == '' and '$(Configuration)' == 'Debug'">http://10.0.2.2:5180</ServidorApp>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyMetadata Include="ServidorApp" Value="$(ServidorApp)" />
	</ItemGroup>
	<Target Name="ValidarServidorApp" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' != 'Debug'">
		<Error Condition="'$(ServidorApp)' == ''"
		       Text="Falta el servidor de la app: publicá con -p:ServidorApp=https://&lt;webAppUrl del deploy&gt;" />
		<Error Condition="'$(ServidorApp)' != '' and !$(ServidorApp.StartsWith('https://'))"
		       Text="ServidorApp tiene que ser https:// fuera de Debug (valor actual: $(ServidorApp))." />
	</Target>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F5EBE0" ForegroundScale="0.72" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F5EBE0" BaseSize="180,180" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DeepArquitectura.Contracts\DeepArquitectura.Contracts.csproj" />
	</ItemGroup>

</Project>
