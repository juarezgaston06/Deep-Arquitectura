<footer>
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="logo">
                    <a href="/"><img src="@Assets["img/logo.png"]" alt="Deep Arquitectura Logo" class="logo-img"></a>
                </div>
            </div>
            <div class="footer-social">
                <h4>Seguinos</h4>
                <div class="social-icons">
                    <a href="@Contacto.Instagram" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 448 512"><path fill="currentColor" d="@Iconos.Instagram" /></svg>
                    </a>
                    <a href="https://wa.me/@Contacto.WhatsAppNumero" target="_blank" rel="noopener" aria-label="WhatsApp">
                        <svg viewBox="0 0 448 512"><path fill="currentColor" d="@Iconos.WhatsApp" /></svg>
                    </a>
                    <a href="@Contacto.Facebook" target="_blank" rel="noopener" aria-label="Facebook">
                        <svg viewBox="0 0 448 512"><path fill="currentColor" d="@Iconos.Facebook" /></svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.UtcNow.Year Deep Arquitectura. Todos los derechos reservados.</p>
        </div>
