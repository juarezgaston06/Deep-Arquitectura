@page "/gas"

<PageTitle>Deep Arquitectura | Soluciones de Gas</PageTitle>
<HeadContent>
    <meta name="description" content="Deep Arquitectura - Servicios especializados de gas. Instalaciones, planos, matriculados y mantenimiento profesional.">
    <style>
        .hero-gas { background-color: #f5f2f0; }
        .service-icon.gas { background: #a67c52; }
        .hero-image-gas { background-image: url('/img/gasista-hero.png'); }
    </style>
</HeadContent>

<SiteHeader>
    <li><a href="/">Inicio</a></li>
    <li><a href="#servicios-gas">Servicios</a></li>
    <li><a href="#contacto">Contacto</a></li>
</SiteHeader>

<main>
    <section id="hero" class="hero hero-gas">
        <div class="hero-content">
            <span class="subtitle reveal">Instalaciones de Gas</span>
            <h1 class="reveal delay-1">Seguridad y <br><span class="highlight">confort</span> térmico.</h1>
            <p class="reveal delay-2">Especialistas matriculados en proyectos de gas para viviendas e industrias.
                Soluciones integrales bajo estrictas normas de seguridad.</p>
            <div class="hero-btns reveal delay-3">
                <a href="#contacto" class="btn btn-primary">Pedir Presupuesto</a>
                <a href="#servicios-gas" class="btn btn-outline">Proyectos de Gas</a>
            </div>
        </div>
        <div class="hero-image hero-image-gas reveal fade-in"></div>
        <div class="leaf-overlay"></div>
    </section>

    <section id="servicios-gas" class="servicios">
        <div class="container">
            <div class="section-header reveal">
                <h2>Servicios de Gas</h2>
                <p>Tramitaciones, instalaciones y mantenimiento por gasistas matriculados.</p>
            </div>
            <div class="services-grid">
                <div class="service-card reveal">
                    <div class="service-icon gas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 2C7 2 3 7 3 12s4 10 9 10 9-5 9-10S17 2 12 2zM12 18c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z" />
                            <path d="M12 8v8M8 12h8" />
                        </svg>
                    </div>
                    <h3>Instalaciones Internas</h3>
                    <p>Ejecución integral de cañerías para gas natural o envasado con materiales de alta calidad.</p>
                </div>
                <div class="service-card reveal">
                    <div class="service-icon gas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5" />
                        </svg>
                    </div>
                    <h3>Planos & Trámites</h3>
                    <p>Presentación de proyectos ante organismos, finales de obra y habilitación de medidores.</p>
                </div>
                <div class="service-card reveal">
                    <div class="service-icon gas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M13 16V6a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2h7a2 2 0 002-2zM2 9h11M17 19l4-4-4-4M21 15H13" />
                        </svg>
                    </div>
                    <h3>Artefactos & Calefacción</h3>
                    <p>Colocación y reparación de calderas, termotanques, cocinas y sistemas de calefacción central.</p>
                </div>
                <div class="service-card reveal">
                    <div class="service-icon gas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                            <path d="M12 9v4M12 17h.01" />
                        </svg>
                    </div>
                    <h3>Pruebas de Hermeticidad</h3>
                    <p>Detección de fugas y verificación técnica para garantizar una instalación segura y reglamentaria.</p>
                </div>
            </div>
        </div>
    </section>

    <ContactSection Titulo="@((MarkupString)"Consulta <br>Instalación")"
                    Texto="Contáctanos para presupuestar tu obra de gas o regularizar una instalación existente."
                    Placeholder="Detalle su necesidad de gas (Ej: Instalación nueva, habilitación de medidor, planos, etc.)"
                    Area="AreaConsulta.Gas" />
</main>
