@page "/admin/obras/{Id:int}/costos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject CostosObra Costos
@inject Adjuntos AdjuntosSvc

<PageTitle>Costos | Deep Arquitectura</PageTitle>

@if (_obra is null) { <p class="muted">Cargando…</p> return; }

<div class="page-head">
    <div>
        <h1>Costos reales · @_obra.Codigo</h1>
        <p><a href="/admin/obras/@Id">← @_obra.Nombre</a></p>
    </div>
</div>

@if (_error is not null) { <div class="alert alert-error">@_error</div> }
@if (_ok is not null) { <div class="alert alert-ok">@_ok</div> }

@* ---------------- Rentabilidad ---------------- *@
@if (_r is not null)
{
    <div class="kpis">
        <div class="kpi"><div class="valor">@Textos.Moneda(_r.Facturable)</div><div class="label">Obra + adicionales</div></div>
        <div class="kpi"><div class="valor">@Textos.Moneda(_r.Costo)</div><div class="label">Costo real</div></div>
        <div class="kpi"><div class="valor">@Textos.Moneda(_r.Margen)</div><div class="label">Margen @(_r.MargenPorcentaje is decimal p ? $"({Textos.Numero(p)}%)" : "")</div></div>
        <div class="kpi"><div class="valor">@Textos.Moneda(_r.Cobrado)</div><div class="label">Cobrado</div></div>
    </div>
    @if (_r.Incompleta)
    {
        <div class="alert alert-info">
            Faltan datos para que el costo sea exacto:
            @if (_r.RenglonesSinPrecio > 0) { <span>@_r.RenglonesSinPrecio renglón(es) de material sin precio (abajo). </span> }
            @if (_r.HorasSinValor > 0) { <span>@Textos.Numero(_r.HorasSinValor) h fichadas de personal sin valor hora (cargalo en <a href="/admin/albaniles">Personal de obra</a>).</span> }
        </div>
    }
    <div class="card">
        <h2>De qué se compone</h2>
        <table>
            <tbody>
                <tr><td>Materiales (recepciones con precio)</td><td>@Textos.Moneda(_r.Materiales)</td></tr>
                <tr><td>Mano de obra (@Textos.Numero(_r.HorasTrabajadas) h fichadas)</td><td>@Textos.Moneda(_r.ManoDeObra)</td></tr>
                @foreach (var (cat, monto) in _r.Gastos.OrderByDescending(g => g.Value)) { <tr><td>@Textos.Etiqueta(cat)</td><td>@Textos.Moneda(monto)</td></tr> }
                @if (_r.Recuperado > 0) { <tr><td>Recuperado por sobrantes</td><td>− @Textos.Moneda(_r.Recuperado)</td></tr> }
            </tbody>
        </table>
        @if (_r.PorEtapa.Count > 0)
        {
            <h3 style="margin-top:1rem">Por etapa</h3>
            <table>
                <thead><tr><th>Etapa</th><th>Materiales</th><th>Mano de obra</th><th>Gastos</th><th>Total</th></tr></thead>
                <tbody>
                    @foreach (var e in _r.PorEtapa)
                    {
                        <tr><td>@e.Etapa</td><td>@Textos.Moneda(e.Materiales)</td><td>@Textos.Moneda(e.ManoDeObra)</td><td>@Textos.Moneda(e.Gastos)</td><td><strong>@Textos.Moneda(e.Total)</strong></td></tr>
                    }
                </tbody>
            </table>
            <p class="muted" style="font-size:.8rem">La mano de obra se reparte entre etapas según el parte diario de cada día; los materiales, según la tarea del pedido.</p>
        }
    </div>
}

@* ---------------- Gastos ---------------- *@
<div class="card">
    <h2>Gastos</h2>
    <p class="muted">Subcontratos, fletes, alquileres, compras sin remito, trámites. El material que llega con remito no va acá: cargale el precio en la recepción.</p>
    <div class="form-grid">
        <div class="field"><label>Fecha</label><input type="date" @bind="_gasto.Fecha" /></div>
        <div class="field">
            <label>Tipo</label>
            <select @bind="_gasto.Categoria">@foreach (var c in Enum.GetValues<CategoriaGasto>()) { <option value="@c">@Textos.Etiqueta(c)</option> }</select>
        </div>
        <div class="field"><label>Qué se pagó</label><input @bind="_gasto.Descripcion" maxlength="300" placeholder="Ej. Volquete 5 m³" /></div>
        <div class="field"><label>Proveedor</label><input @bind="_gasto.Proveedor" maxlength="150" /></div>
        <div class="field"><label>N° comprobante</label><input @bind="_gasto.NumeroComprobante" maxlength="60" /></div>
        <div class="field"><label>Monto ($)</label><input type="number" min="0" step="0.01" @bind="_gasto.Monto" /></div>
        <div class="field">
            <label>Etapa</label>
            <select @bind="_gasto.EtapaObraId"><option value="">—</option>@foreach (var e in _etapas) { <option value="@e.Id">@e.Nombre</option> }</select>
        </div>
    </div>
    <div class="form-actions"><button class="btn btn-sm" @onclick="AgregarGastoAsync">Agregar gasto</button></div>

    @if (_gastos.Count > 0)
    {
        <table style="margin-top:1rem">
            <thead><tr><th>Fecha</th><th>Qué</th><th>Tipo</th><th>Monto</th><th>Comprobante</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in _gastos)
                {
                    <tr>
                        <td>@Textos.Fecha(g.Fecha)</td>
                        <td>@g.Descripcion<div class="muted">@g.Proveedor @(g.Etapa is null ? "" : "· " + g.Etapa.Nombre) @(g.Capataz is null ? "" : "· cargado por " + g.Capataz.Nombre)</div></td>
                        <td>@Textos.Etiqueta(g.Categoria)</td>
                        <td>@Textos.Moneda(g.Monto)</td>
                        <td>
                            <AdjuntosGaleria Items="g.Adjuntos" />
                            <SubirAdjuntos Texto="Adjuntar" OnSubir="a => SubirComprobanteAsync(g.Id, a)" />
                        </td>
                        <td><button class="btn-link btn-danger" @onclick="() => BorrarGastoAsync(g.Id)">Borrar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ---------------- Recepciones ---------------- *@
<div class="card">
    <h2>Material recibido: precios de la factura</h2>
    @if (_recepciones.Count == 0) { <p class="empty">No llegó material registrado desde la obra.</p> }
    @foreach (var r in _recepciones)
    {
        <div style="border-top:1px solid var(--line);padding:.75rem 0">
            <strong>@Textos.Fecha(r.Fecha)</strong> · remito @(r.NumeroRemito ?? "s/n") · recibió @(r.Albanil?.Nombre ?? r.Capataz?.Nombre ?? "—")
            <div class="form-grid" style="margin-top:.5rem">
                <div class="field"><label>Proveedor</label><input value="@r.Proveedor" @onchange="e => _proveedor[r.Id] = e.Value?.ToString()" maxlength="150" /></div>
                <div class="field"><label>N° factura</label><input value="@r.NumeroFactura" @onchange="e => _factura[r.Id] = e.Value?.ToString()" maxlength="60" /></div>
            </div>
            <table>
                <thead><tr><th>Material</th><th>Cantidad</th><th>Precio unitario ($)</th><th>Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var i in r.Items)
                    {
                        <tr>
                            <td>@i.Material</td>
                            <td>@Textos.Numero(i.Cantidad) @i.Unidad</td>
                            <td><input type="number" min="0" step="0.01" style="max-width:140px" value="@_precios.GetValueOrDefault(i.Id)?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       @onchange="e => _precios[i.Id] = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var p) ? p : null" /></td>
                            <td>@(_precios.GetValueOrDefault(i.Id) is decimal pu ? Textos.Moneda(pu * i.Cantidad) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="form-actions">
                <button class="btn btn-sm" @onclick="() => GuardarPreciosAsync(r)">Guardar precios</button>
                <SubirAdjuntos Texto="Adjuntar factura" OnSubir="a => SubirFacturaAsync(r.Id, a)" />
                <AdjuntosGaleria Items="_facturas.Where(f => f.RecepcionMaterialId == r.Id).ToList()" />
            </div>
        </div>
    }
</div>

@* ---------------- Sobrantes ---------------- *@
<div class="card">
    <h2>Sobrantes y devoluciones</h2>
    <p class="muted">Al cerrar una etapa: qué sobró y qué se hizo. Con esto se mide el desperdicio real de cada material (ver Indicadores).</p>
    <div class="form-grid">
        <div class="field"><label>Fecha</label><input type="date" @bind="_sob.Fecha" /></div>
        <div class="field"><label>Material</label><input @bind="_sob.Material" maxlength="150" placeholder="Ej. Cemento" /></div>
        <div class="field"><label>Cantidad</label><input type="number" min="0" step="0.01" @bind="_sob.Cantidad" /></div>
        <div class="field"><label>Unidad</label><input @bind="_sob.Unidad" maxlength="20" placeholder="bolsas, m³, u" /></div>
        <div class="field">
            <label>Qué se hizo</label>
            <select @bind="_sob.Destino">@foreach (var d in Enum.GetValues<DestinoSobrante>()) { <option value="@d">@Textos.Etiqueta(d)</option> }</select>
        </div>
        @if (_sob.Destino == DestinoSobrante.OtraObra)
        {
            <div class="field">
                <label>A qué obra</label>
                <select @bind="_sob.ObraDestinoId"><option value="">—</option>@foreach (var o in _otrasObras) { <option value="@o.Id">@o.Codigo · @o.Nombre</option> }</select>
            </div>
        }
        @if (_sob.Destino != DestinoSobrante.Desperdicio)
        {
            <div class="field"><label>Valor recuperado ($)</label><input type="number" min="0" @bind="_sob.ValorRecuperado" /></div>
        }
        <div class="field">
            <label>Etapa</label>
            <select @bind="_sob.EtapaObraId"><option value="">—</option>@foreach (var e in _etapas) { <option value="@e.Id">@e.Nombre</option> }</select>
        </div>
    </div>
    <div class="form-actions"><button class="btn btn-sm" @onclick="AgregarSobranteAsync">Registrar</button></div>
    @if (_sobrantes.Count > 0)
    {
        <table style="margin-top:1rem">
            <tbody>
                @foreach (var s in _sobrantes)
                {
                    <tr>
                        <td>@Textos.Fecha(s.Fecha)</td>
                        <td>@Textos.Numero(s.Cantidad) @s.Unidad de @s.Material</td>
                        <td>@Textos.Etiqueta(s.Destino) @(s.ObraDestino is null ? "" : "→ " + s.ObraDestino.Codigo)</td>
                        <td>@(s.ValorRecuperado is decimal v ? Textos.Moneda(v) : "")</td>
                        <td><button class="btn-link btn-danger" @onclick="() => BorrarSobranteAsync(s.Id)">Borrar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Obra? _obra;
    private CostosObra.Rentabilidad? _r;
    private List<EtapaObra> _etapas = [];
    private List<Obra> _otrasObras = [];
    private List<GastoObra> _gastos = [];
    private List<RecepcionMaterial> _recepciones = [];
    private List<Adjunto> _facturas = [];
    private List<MaterialSobrante> _sobrantes = [];
    private Dictionary<int, decimal?> _precios = [];
    private Dictionary<int, string?> _proveedor = [], _factura = [];
    private CostosObra.DatosGasto _gasto = new() { Fecha = Textos.HoyLocal() };
    private CostosObra.DatosSobrante _sob = new() { Fecha = Textos.HoyLocal() };
    private string? _error, _ok;

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _obra = await db.Obras.AsNoTracking().SingleOrDefaultAsync(o => o.Id == Id);
        if (_obra is null) { _error = "La obra no existe."; _obra = new Obra { Nombre = "", Codigo = "" }; return; }
        _etapas = await db.Etapas.AsNoTracking().Where(e => e.ObraId == Id).OrderBy(e => e.Orden).ToListAsync();
        _otrasObras = await db.Obras.AsNoTracking().Where(o => o.Id != Id && o.Estado != EstadoObra.Finalizada && o.Estado != EstadoObra.Cancelada)
            .OrderBy(o => o.Nombre).ToListAsync();
        _facturas = await db.Adjuntos.AsNoTracking().Where(a => a.ObraId == Id && a.RecepcionMaterialId != null).ToListAsync();
        _gastos = await Costos.GastosAsync(Id);
        _recepciones = await Costos.RecepcionesAsync(Id);
        _precios = _recepciones.SelectMany(r => r.Items).ToDictionary(i => i.Id, i => i.PrecioUnitario);
        _sobrantes = await Costos.SobrantesAsync(Id);
        _r = await Costos.RentabilidadAsync(Id);
    }

    private void Resultado(string? error, string ok) { _error = error; _ok = error is null ? ok : null; }

    private async Task AgregarGastoAsync()
    {
        var (_, error) = await Costos.RegistrarGastoAsync(Id, _gasto);
        Resultado(error, "Gasto agregado.");
        if (error is null) { _gasto = new() { Fecha = _gasto.Fecha, Categoria = _gasto.Categoria }; await CargarAsync(); }
    }

    private async Task BorrarGastoAsync(int id) { await Costos.BorrarGastoAsync(id); await CargarAsync(); }

    private async Task<string?> SubirComprobanteAsync(int gastoId, IReadOnlyCollection<Adjuntos.Archivo> a)
    {
        var error = await Costos.AgregarComprobanteAsync(gastoId, a);
        if (error is null) await CargarAsync();
        return error;
    }

    private async Task<string?> SubirFacturaAsync(int recepcionId, IReadOnlyCollection<Adjuntos.Archivo> a)
    {
        var error = await Costos.AgregarFacturaAsync(recepcionId, a);
        if (error is null) await CargarAsync();
        return error;
    }

    private async Task GuardarPreciosAsync(RecepcionMaterial r)
    {
        var precios = r.Items.ToDictionary(i => i.Id, i => _precios.GetValueOrDefault(i.Id));
        var error = await Costos.GuardarPreciosAsync(r.Id, precios, _proveedor.GetValueOrDefault(r.Id) ?? r.Proveedor,
            _factura.TryGetValue(r.Id, out var f) ? f : r.NumeroFactura);
        Resultado(error, "Precios guardados.");
        if (error is null) await CargarAsync();
    }

    private async Task AgregarSobranteAsync()
    {
        var (_, error) = await Costos.RegistrarSobranteAsync(Id, _sob);
        Resultado(error, "Sobrante registrado.");
        if (error is null) { _sob = new() { Fecha = _sob.Fecha }; await CargarAsync(); }
    }

    private async Task BorrarSobranteAsync(int id) { await Costos.BorrarSobranteAsync(id); await CargarAsync(); }
}
