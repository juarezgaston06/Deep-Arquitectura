@page "/mi-obra/mas"
@inherits PaginaCliente
@inject AppCliente App

<PageTitle>Más | Mi obra</PageTitle>

<h1>Más</h1>

<ul class="lista menu">
    <li><a class="fila-enlace" href="/mi-obra/aprobaciones"><strong>Aprobaciones</strong>
        @if (_aprobaciones > 0) { <span class="insignia">@_aprobaciones</span> } <span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="/mi-obra/pagos"><strong>Certificados y pagos</strong><span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="/mi-obra/documentos"><strong>Planos y documentos</strong><span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="/mi-obra/tramites"><strong>Trámites y permisos</strong><span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="/mi-obra/entrega"><strong>Acta de entrega</strong>
        @if (_actaParaFirmar) { <span class="insignia">!</span> } <span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="/mi-obra/garantia"><strong>Reclamos y garantía</strong><span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="/mi-obra/compartir"><strong>¿Podemos mostrar tu obra?</strong><span class="flecha">›</span></a></li>
    <li><a class="fila-enlace" href="https://wa.me/@Contacto.WhatsAppNumero" target="_blank" rel="noopener"><strong>WhatsApp del estudio</strong><span class="suave chico">@Contacto.WhatsAppVisible</span></a></li>
</ul>

@* Lo muestra app.js: en Android cuando el navegador ofrece instalar; en iPhone, las instrucciones. *@
<section class="tarjeta" id="instalar" hidden>
    <strong>Tenela como app</strong>
    <p class="suave chico">Agregala a la pantalla de inicio para abrirla con un toque.</p>
    <button type="button" class="boton" id="instalar-boton">Instalar</button>
</section>
<section class="tarjeta" id="instalar-ios" hidden>
    <strong>Tenela como app en el iPhone</strong>
    <p class="suave chico">Tocá <b>Compartir</b> (el cuadrado con la flecha) y después <b>Agregar a inicio</b>.</p>
</section>

<form method="post" action="/mi-obra/salir" class="salir" data-salir>
    <AntiforgeryToken />
    <button type="submit" class="boton boton-sec">Cerrar sesión en este teléfono</button>
</form>

@code {
    [Inject] private Postventa Postventa { get; set; } = null!;
    private int _aprobaciones;
    private bool _actaParaFirmar;

    protected override async Task CargarAsync()
    {
        (_aprobaciones, _) = await App.AvisosAsync(ObraId);
        _actaParaFirmar = (await Postventa.ActaAsync(ObraId, paraCliente: true))?.Estado == EstadoActa.Abierta;
    }
}
